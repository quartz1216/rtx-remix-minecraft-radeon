{
    "schemaVersion": 1,
    "id": "rtx-remix-renderer",
    "version": "${version}",
    "name": "RTX Remix for Minecraft (Unofficial Radeon Fork)",
    "description": "Unofficial fork of NVIDIA's RTX Remix for Minecraft, targeting AMD Radeon GPUs. Renders Minecraft through the RTX Remix path tracer. Not affiliated with or endorsed by NVIDIA or AMD. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
    "authors": [
        "quxomiya"
    ],
    "contributors": [
        "NVIDIA (original RTX Remix for Minecraft)"
    ],
    "contact": {
        "homepage": "https://github.com/quartz1216/rtx-remix-minecraft-radeon",
        "sources": "https://github.com/quartz1216/rtx-remix-minecraft-radeon",
        "issues": "https://github.com/quartz1216/rtx-remix-minecraft-radeon/issues"
    },
    "license": "Apache-2.0",
    "environment": "*",
    "entrypoints": {
        "preLaunch": [
            "com.nvidia.rtxremix.minecraft.WorkerPoolCap"
        ],
        "main": [
            "com.nvidia.rtxremix.minecraft.RtxRemixCommonMod"
        ],
        "client": [
            "com.nvidia.rtxremix.minecraft.RtxRemixMod"
        ]
    },
    "mixins": [
        "rtx-remix-renderer.mixins.json"
    ],
    "accessWidener": "rtx-remix-renderer.accesswidener",
    "depends": {
        "fabricloader": ">=0.16.5",
        "fabric-api": ">=0.116.10+1.21.1",
        "minecraft": "1.21.1",
        "java": ">=21"
    }
}
